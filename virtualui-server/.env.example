# Is file ko .env me copy karke values bharo. Real secrets kabhi commit mat karo.

NODE_ENV=development
PORT=8000
MONGO_URI=

# --- JWT (default algorithm HS256) ---
# Dono secrets alag aur kam se kam 32 chars ke hone chahiye.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional: token lifetime (seconds). Default: access 900 (15 min), refresh 604800 (7 din)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# --- JWT (RS256 use karna ho to, key rotation ke saath) ---
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_KEY_ID=2026-10
# Rotation ke time purani public keys (kid -> key) JSON me, jab tak purane tokens expire na ho jayein:
# JWT_PREVIOUS_PUBLIC_KEYS={"2026-04":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}

# Google OAuth Web Client ID (ID token verify karne ke liye)
GOOGLE_CLIENT_ID=

# Frontend ka URL: CORS allowed origin + email links (verify / reset) isse bante hain.
# Development me default http://localhost:5173. Production me zaroor set karo.
# CLIENT_URL=https://app.example.com

# Optional: reverse proxy (nginx / load balancer) ke peeche ho to proxies ki sankhya (rate limit sahi IP dekhe)
# TRUST_PROXY=1
